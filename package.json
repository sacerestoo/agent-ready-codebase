{
  "name": "void-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run check && vp build",
    "check": "void prepare && vp check && bun run check:architecture",
    "check:architecture": "bun run tooling/check-architecture.ts",
    "check:env": "bun run tooling/check-env.ts && void env check",
    "deploy": "void deploy --platform cloudflare",
    "dev": "vp dev",
    "postinstall": "void prepare",
    "prepare": "vp config --no-agent",
    "preview": "vp build && vp preview",
    "test": "vp test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@void/react": "1.2.1",
    "dependency-cruiser": "^18.7.0",
    "oxc-transform-react": "^0.149.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "void": "1.2.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  }
}
